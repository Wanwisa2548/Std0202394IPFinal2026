# Copy to backend/.env and fill in. If DB_HOST/DB_USER/DB_NAME are missing or
# MySQL cannot be reached, the server falls back to IN-MEMORY storage.
#
# On the university server (119.59.102.161) MySQL is reached as "localhost",
# and the backend must listen on your assigned port (3038).
PORT=3038
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ip_std6730202394
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
